{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Vendored OpenUI (vendor/openui) */
    "paths": {
      "@openuidev/react-lang": ["./vendor/openui/react-lang/index.d.mts"],
      "@openuidev/lang-core": ["./vendor/openui/lang-core/index.d.mts"],
      "@openuidev/observability": ["./vendor/openui/observability/index.d.mts"]
    }
  },
  "include": ["src"]
}
